# What your editor should do before a formatter ever runs.
#
# This file is not a second opinion. Every value below is the value the tool
# that actually gates the file already emits - `rustfmt` for Rust, `taplo`
# for TOML, `prettier`-shaped defaults for YAML/JSON. An editor save and a
# `--check` run therefore cannot disagree, which is the point: a contributor
# should never learn about formatting drift from a red X when their editor
# could have told them.
#
# `max_line_length` is deliberately absent. Wrap policy belongs to the
# formatters, which know about string literals, URLs, and the column-aligned
# tables this repository is full of; a flat cap here would only fight them.
#
# Spec: https://spec.editorconfig.org/

root = true

# Universal - applies to every text file in the tree.
[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 4

# Rust: rustfmt `tab_spaces = 4`.
[*.rs]
indent_style = space
indent_size  = 4

# Data and markup: 2-space, which is what taplo and the GitHub Actions schema
# both default to.
[*.{toml,yml,yaml,json}]
indent_style = space
indent_size  = 2

# Shell: matches `shfmt -i 2`.
[*.{sh,bash}]
indent_style = space
indent_size  = 2

# Markdown keeps trailing whitespace: two trailing spaces are a hard line
# break, and trimming them silently rewrites the rendered page.
[*.md]
trim_trailing_whitespace = false

# Fixed-column data. Nothing indents these, and an editor that re-aligns a
# column breaks the parser reading them.
[*.{csv,tsv,baseline}]
indent_style             = unset
indent_size              = unset
trim_trailing_whitespace = false
